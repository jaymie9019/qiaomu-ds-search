{
  "name": "qiaomu-ds-search",
  "version": "1.2.0",
  "owner": "向阳乔木",
  "updated_at": "2026-10-18",
  "status": "active",
  "maturity_tier": "governed",
  "lifecycle_stage": "production",
  "context_budget_tier": "production",
  "review_cadence": "quarterly and on API changes",
  "target_platforms": [
    "openai",
    "claude",
    "generic",
    "agent-skills-compatible"
  ],
  "release_gates": [
    "package",
    "trigger-smoke",
    "unit-tests",
    "secret-scan",
    "live-evidence-or-explicit-missing",
    "clean-install"
  ],
  "intent": {
    "job_to_be_done": "由调用 Skill 的模型理解任意搜索主题、展开和迭代查询，以 DeepSeek Search/Fetch 获取可核对证据",
    "inputs": [
      "任意主题关键词或自然语言问题",
      "模型拆解后的短查询",
      "公开网页 URL",
      "用户在本机隐藏输入的 API Key"
    ],
    "outputs": [
      "带来源与查询命中关系的 JSON",
      "模型组织的证据摘要",
      "计划执行与本批预算状态",
      "重复版本证据与离线合并结果",
      "缺口、冲突及停止原因"
    ],
    "exclusions": [
      "聊天模型调用",
      "付费墙绕过",
      "全站爬虫",
      "代用户充值"
    ]
  }
}
